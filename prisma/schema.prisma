// The Carnival of Lies — data model
// Local SQLite for dev; swap datasource for Postgres/Supabase at deploy time.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Suspect {
  id          String  @id @default(cuid())
  name        String
  role        String
  flavourText String
  isMurderer  Boolean @default(false)
  order       Int     @default(0)

  nodes       Node[]
  clearances  Clearance[]
  notes       TeamNote[]
  accusations Accusation[]
}

model Node {
  id                  String  @id @default(cuid())
  sequenceIndex       Int     @unique // 0..7 story nodes; -1 reserved (unused)
  suspectId           String?
  suspect             Suspect? @relation(fields: [suspectId], references: [id])

  locationName        String
  locationDescription String
  act                 Int // 1, 2, or 3

  testimonyText       String
  isTruthful          Boolean
  brokenMark          String // NONE | THREE | CASEFILE | NAME

  riddlePlain         String
  riddleMirrored       String
  mirrorStyle          String // directional | negation | reversed | antonym

  clearReason          String? // shown on deduction board when cleared; null for the murderer's node

  token                String  @unique // opaque QR payload for this node

  isDecoy              Boolean @default(false)
  decoyForIndexes      String? // comma-separated sequenceIndex list this decoy serves, when isDecoy
  decoyPassage          String? // "you have been misled" text, when isDecoy

  scans                Scan[]
  verdicts              Verdict[]
  clearances            Clearance[]
}

model Team {
  id             String    @id @default(cuid())
  teamCode       String    @unique
  name           String
  members        String // JSON-encoded string[]
  contact        String

  currentIndex   Int       @default(0) // sequenceIndex of the node currently in play
  penaltySeconds Int       @default(0)
  status         String    @default("ACTIVE") // ACTIVE | FINISHED

  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  scans          Scan[]
  verdicts       Verdict[]
  clearances     Clearance[]
  notes          TeamNote[]
  accusation     Accusation?
}

model Scan {
  id              String   @id @default(cuid())
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])
  nodeId          String
  node            Node     @relation(fields: [nodeId], references: [id])
  scannedAt       DateTime @default(now())
  wasValid        Boolean
  rejectionReason String?
}

model Verdict {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  nodeId      String
  node        Node     @relation(fields: [nodeId], references: [id])
  choice      String // TRUTH | LIE
  wasCorrect  Boolean
  submittedAt DateTime @default(now())
}

model Clearance {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  suspectId String
  suspect   Suspect  @relation(fields: [suspectId], references: [id])
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id])
  reason    String
  clearedAt DateTime @default(now())
}

model TeamNote {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  suspectId String
  suspect   Suspect  @relation(fields: [suspectId], references: [id])
  note      String
  updatedAt DateTime @updatedAt

  @@unique([teamId, suspectId])
}

model Accusation {
  id          String   @id @default(cuid())
  teamId      String   @unique
  team        Team     @relation(fields: [teamId], references: [id])
  suspectId   String
  suspect     Suspect  @relation(fields: [suspectId], references: [id])
  reasoning   String
  wasCorrect  Boolean
  submittedAt DateTime @default(now())
}
