# Copy to .env for local development (`cp .env.example .env`).

# Local SQLite (relative to project root / process CWD).
DATABASE_URL="file:./prisma/dev.db"

# Production / Docker: use an absolute path on a persistent volume, e.g.
# DATABASE_URL="file:/data/carnival.db"
# NODE_ENV=production

# Min 16 chars. Required in production. Dev falls back to a fixed local secret if unset.
QR_HMAC_SECRET="change-me-to-a-long-random-secret"

# Organiser console at /admin. Dev falls back to "carnival-dev-admin" if unset.
# Production requires 8+ characters.
ADMIN_PASSWORD="carnival-dev-admin"

# Recommended in production: pepper for admin session cookies (falls back to
# QR_HMAC_SECRET, then a weak dev-only default if unset).
# ADMIN_SESSION_SECRET="change-me-admin-session-pepper"
